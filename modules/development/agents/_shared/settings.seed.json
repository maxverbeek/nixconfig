{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch",
      "Grep",
      "Glob",
      "Read",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(which *)",
      "Bash(where *)",
      "Bash(whereis *)",
      "Bash(type *)",
      "Bash(file *)",
      "Bash(wc *)",
      "Bash(du *)",
      "Bash(df *)",
      "Bash(stat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(cat *)",
      "Bash(tree *)",
      "Bash(pwd)",
      "Bash(env)",
      "Bash(printenv *)",
      "Bash(uname *)",
      "Bash(id)",
      "Bash(whoami)",
      "Bash(nix build .*)",
      "Bash(nix search .*)",
      "Bash(curl https://raw.githubusercontent.com/*)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(bash /home/max/nixconfig/modules/development/agents/_plugins/*/skills/*/fetch.sh *)",
      "Bash(bash /home/max/nixconfig/modules/development/agents/_plugins/*/skills/*/fetch.sh)"
    ],
    "deny": [
      "Bash(*git push*--force*)",
      "Bash(*git push*-f *)",
      "Bash(*git push*-f)",
      "Bash(*git push*--mirror*)",
      "Bash(git filter-branch*)",
      "Bash(git reflog expire*)",
      "Bash(git reflog delete*)"
    ],
    "ask": [
      "Bash(find*-delete*)",
      "Bash(find*-exec*rm*)",
      "Bash(find*-execdir*rm*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "command -v stalker-claude-prompt >/dev/null 2>&1 && exec stalker-claude-prompt; exit 0",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/notify.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/block-store-glob.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "$HOME/.claude/hooks/usage-dump.sh 'starship statusline claude-code --profile claude'"
  },
  "alwaysThinkingEnabled": false,
  "effortLevel": "medium",
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true
}
